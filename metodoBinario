import java.util.Arrays;
import java.util.Random;
import java.util.Scanner;

public class busca {
    static void mergeSort(String[] v, int ini, int fim) {
        if (ini < fim) {
            int meio = (ini + fim) / 2;
            mergeSort(v, ini, meio);
            mergeSort(v, meio + 1, fim);
            intercalar(v, ini, meio, fim);
        }
    }

    static void intercalar(String[] v, int ini, int meio, int fim) {
        String[] aux = new String[fim - ini + 1];
        int i = ini, j = meio + 1, k = 0;

        while (i <= meio && j <= fim) {
            
            if (v[i].compareToIgnoreCase(v[j]) <= 0) aux[k++] = v[i++];
            else aux[k++] = v[j++];
        }
        while (i <= meio) aux[k++] = v[i++];
        while (j <= fim) aux[k++] = v[j++];

        for (k = 0; k < aux.length; k++) {
            v[ini + k] = aux[k];
        }
    }

    static int buscaBinaria(int[] v, int alvo) {
        int ini = 0, fim = v.length - 1;
        while (ini <= fim) {
            int meio = ini + (fim - ini) / 2;
            if (v[meio] == alvo) return meio;
            else if (alvo < v[meio]) fim = meio - 1;
            else ini = meio + 1;
        }
        return -1;
    }

    static int buscaBinaria(String[] v, String alvo) {
        int ini = 0, fim = v.length - 1;
        while (ini <= fim) {
            int meio = ini + (fim - ini) / 2;
    
            int cmp = alvo.compareToIgnoreCase(v[meio]);
            if (cmp == 0) return meio;
            else if (cmp < 0) fim = meio - 1;
            else ini = meio + 1;
        }
        return -1;
    }

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        System.out.println("Escolha o tipo de dados:");
        System.out.println("1 - Lista de frutas (String)");
        System.out.println("2 - Números aleatórios (int)");
        int opcao = Integer.parseInt(sc.nextLine().trim());

        if (opcao == 1) {
            String[] lista = {"Uva", "abacaxi", "Pêra", "manga", "Caju", "maçã",
                    "Laranja", "banana", "Kiwi", "limão", "Abacate", "goiaba",
                    "Morango", "acerola", "Pitaya", "caqui", "Jabuticaba",
                    "amora", "Framboesa", "cereja"};

            mergeSort(lista, 0, lista.length - 1);
            System.out.println("Lista ordenada: " + Arrays.toString(lista));

            System.out.print("Fruta a buscar: ");
            String alvo = sc.nextLine().trim();

            int pos = buscaBinaria(lista, alvo);
            if (pos >= 0) System.out.println("Encontrada na posição " + pos + " (" + lista[pos] + ")");
            else System.out.println("Fruta não encontrada.");

        } else {
            Random rnd = new Random();
            int[] nums = new int[20];
            for (int i = 0; i < nums.length; i++) {
                nums[i] = rnd.nextInt(100);
            }

            Arrays.sort(nums);
            System.out.println("Números ordenados: " + Arrays.toString(nums));

            System.out.print("Número a buscar: ");
            int alvo = Integer.parseInt(sc.nextLine().trim());

            int pos = buscaBinaria(nums, alvo);
            if (pos >= 0) System.out.println("Encontrado na posição " + pos);
            else System.out.println("Número não encontrado.");
        }
        
        sc.close();
    }
}
