import java.util.Arrays;

public class ordemNomes { 

    public static void main(String[] args) {
        String[] nomesL = {"ana", "Bruno", "carla", "Diego", "eduarda", "Felipe", "gabriela", "Henrique", "isabela", "João"};
        
        ordenarMerge(nomesL);
        
        exibir(nomesL);
    }

    public static void ordenarMerge(String[] nomeL) {
        mergeSort(0, nomeL.length, nomeL);
    }

    private static void mergeSort(int inicio, int tamanho, String[] v) {
        if (inicio < tamanho - 1) {
            int meio = (inicio + tamanho) / 2;
            mergeSort(inicio, meio, v);
            mergeSort(meio, tamanho, v);
            intercalar(inicio, meio, tamanho, v);
        }
    }

    private static void intercalar(int inicio, int meio, int tamanho, String[] v) {
        int i; 
        int j;
        int k;
        String[] auxiliar = new String[tamanho - inicio];
        i = inicio;
        j = meio;
        k = 0;

        while (i < meio && j < tamanho) {
            if (v[i].compareTo(v[j]) <= 0) {
                auxiliar[k] = v[i];
                k++;
                i++;
            } else {
                auxiliar[k] = v[j];
                k++;
                j++;
            }
        }

        while (i < meio) {
            auxiliar[k] = v[i];
            k++;
            i++;
        }

        while (j < tamanho) {
            auxiliar[k] = v[j];
            k++;
            j++;
        }

        for (i = inicio; i < tamanho; i++) {
            v[i] = auxiliar[i - inicio];
        }
    }

    public static void exibir(String[] nomeL) {
        System.out.println(Arrays.toString(nomeL));
    }
}
