    public static int somas(int a, int b){
        return a+b;
    }
    public static void mostraArray(int[] numero){
        for(int i=0;i<numero.length;i++){
            System.out.print(numero[i]+" ");
        }
    }    
    public static int m(int[] numero){
        int maior =numero[0];
        for(int n: numero){
            if(n>maior){
                maior=n;
            }
        }
        return maior;
    }
    public static int menor(int[] numero){
        int menos=numero[0];
        for(int i=0;i<numero.length;i++){
            if(numero[i]<menos){
                menos=numero[i];
            }
        }
        return menos;
        
